# Audio orchestration only; numeric audio assertions live in the C# fixtures.
load_lib thsss.exp

if {![info exists env(THSSS_AUDIO_TEST_DLL)]} {
    error "THSSS_AUDIO_TEST_DLL must name the built backend-neutral test DLL"
}
set dll $env(THSSS_AUDIO_TEST_DLL)

# The two error-path cases assert an expected failure: the marker proves the intended
# diagnostic was printed, and the non-zero exit is the contract, not a regression.
thsss_run "OpenAL shared audio contract" \
    [list env THSSS_AUDIO_BACKEND=openal ALSOFT_DRIVERS=null dotnet $dll] \
    {PASS AudioBackendCompatibility:} 0 45
thsss_run "Invalid backend fails explicitly without fallback" \
    [list env THSSS_AUDIO_BACKEND=invalid dotnet $dll --selection-probe] \
    {ArgumentException: Unknown THSSS_AUDIO_BACKEND} 1 45
thsss_run "Windows native backend rejected on Linux" \
    [list env THSSS_AUDIO_BACKEND=xaudio2 dotnet $dll --selection-probe] \
    {PlatformNotSupportedException:.*requires Windows} 1 45

# Wine is optional: the CI job supplies a self-contained Windows build plus a private
# prefix. Skipping here is not a silent pass - the case simply is not recorded.
if {[info exists env(THSSS_AUDIO_WINE_EXE)]} {
    if {![info exists env(WINEPREFIX)]} { error "Set an isolated WINEPREFIX for the Wine test" }
    thsss_run "Windows XAudio2 shared contract under Wine" \
        [list env THSSS_AUDIO_BACKEND=xaudio2 WINEDEBUG=-all wine $env(THSSS_AUDIO_WINE_EXE)] \
        {PASS AudioBackendCompatibility:} 0 45
}
