# Rendering suites. Process, timeout and exit code come from the shared driver in
# ../lib; every pixel assertion stays in its C# fixture.
load_lib thsss.exp

set root [thsss_root]
set env(ALSOFT_DRIVERS) null

# Several fixtures address game assets with paths relative to the game project
# (for example "../game/FX/Blur.fx"), so they run from src/. The shared driver
# restores the previous directory afterwards.
set workdir [file join $root src]

# Markers come from each fixture's own final print, so "PASS any line" is not enough.
thsss_run VulkanBackend         [thsss_dotnet_run VulkanBackend]         {PASS VulkanBackend}                 0 240 $workdir
thsss_run ShaderAudit           [thsss_dotnet_run ShaderAudit]           {PASS: }                             0 240 $workdir
thsss_run ShaderGpuAudit        [thsss_dotnet_run ShaderGpuAudit]        {PASS: former shader audit defects}  0 240 $workdir
thsss_run GraphicsCompatibility [thsss_dotnet_run GraphicsCompatibility] {PASS: texture row orientation}      0 240 $workdir
thsss_run MatrixConventions     [thsss_dotnet_run MatrixConventions]     {PASS: stage camera target/origin}   0 240 $workdir
thsss_run MathCompatibility     [thsss_dotnet_run MathCompatibility]     {PASS: GL upload}                    0 240 $workdir
thsss_run EffectCompatibility   [thsss_dotnet_run EffectCompatibility]   {PASS API: sources}                  0 240 $workdir
thsss_run MeshCompatibility     [thsss_dotnet_run MeshCompatibility]     {PASS: }                             0 240 $workdir
thsss_run LightingCompatibility [thsss_dotnet_run LightingCompatibility] {PASS: [0-9]+ lighting state}        0 240 $workdir
